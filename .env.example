RIDE_PORT=8081
LOCATION_PORT=8082
MATCHING_PORT=8083
NOTIFICATION_PORT=8084
AUTH_PORT=8085
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
GIN_MODE=release
LOG_LEVEL=info
JWT_SECRET=local-development-secret-at-least-32-bytes
JWT_ISSUER=ride-share
JWT_AUDIENCE=ride-share-api
INTERNAL_TOKEN=local-internal-token-change-for-deployment
AUTH_FIXTURES=fixtures/accounts.json
DATABASE_URL=postgres://ride:ride_local@localhost:5432/rides?sslmode=disable
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://ride:ride_local@localhost:5672/
RIDE_URL=http://localhost:8081
RIDE_URLS=http://localhost:8081,http://localhost:9081
LOCATION_URL=http://localhost:8082
MATCHING_URL=http://localhost:8083
NOTIFICATION_URL=http://localhost:8084
AUTH_URL=http://localhost:8085
ACCEPT_MODE=redis_sql
DB_MAX_OPEN_CONNS=10
DB_TIMEOUT=2s
REDIS_TIMEOUT=100ms
REDIS_LOCK_TTL=5s
